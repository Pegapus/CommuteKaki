<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Commuter Companion</title>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div id="map"></div>

<div id="header-panel">
    <h1>Smart Commuter Companion</h1>
    <p id="panel-subtitle">Click an MRT station to see bus services connecting it to another station via free boarding/alighting points.</p>
</div>

<div id="panel" class="collapsible-panel collapsed">
    <button id="panel-toggle" class="panel-toggle" title="Toggle Panel">❯</button>
    <div class="panel-tabs">
        <button id="tab-search" class="panel-tab active">Explore & Search</button>
        <button id="tab-p2p" class="panel-tab">Point-to-Point Route</button>
    </div>
    
    <div id="tab-content-search" class="tab-content">
        <div id="search-bar">
            <input id="global-search-input" type="text" placeholder="Search bus service or MRT station…" autocomplete="off" />
            <div id="search-suggestions" hidden></div>
        </div>
        <div id="panel-scroll">
            <div id="status-line">Loading MRT stations…</div>
        </div>
    </div>

    <div id="tab-content-p2p" class="tab-content" hidden>
        <div id="p2p-section">
            <div class="p2p-input-container">
                <input id="p2p-origin-input" class="p2p-input" type="text" placeholder="Origin MRT station…" autocomplete="off" />
                <div id="p2p-origin-suggestions" class="p2p-suggestions" hidden></div>
            </div>
            <div class="p2p-input-container">
                <input id="p2p-dest-input" class="p2p-input" type="text" placeholder="Destination MRT station…" autocomplete="off" />
                <div id="p2p-dest-suggestions" class="p2p-suggestions" hidden></div>
            </div>
            <div class="p2p-buttons">
                <button id="p2p-search-btn" class="p2p-btn">Search Route</button>
                <button id="p2p-clear-btn" class="p2p-btn">Clear</button>
            </div>
            <div id="p2p-results"></div>
        </div>
    </div>
</div>

<div id="route-info-banner" hidden>
    <span id="route-info-text"></span>
    <button id="route-info-close" title="Clear route">&times;</button>
</div>

<div id="layer-panel">
    <div id="layer-panel-title">Layers</div>
    <label class="layer-toggle">
        <input type="checkbox" id="toggle-mrt-stations" checked>
        <span>MRT Stations</span>
    </label>
</div>

<script>
const MAPBOX_API_KEY = <%- JSON.stringify(MAPBOX_API_KEY) %>;
mapboxgl.accessToken = MAPBOX_API_KEY;

const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/light-v11',
    center: [103.8198, 1.3521],
    zoom: 11,
    maxBounds: [[103.55, 1.15], [104.15, 1.5]]
});

map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
map.addControl(new mapboxgl.GeolocateControl({
    positionOptions: { enableHighAccuracy: true },
    trackUserLocation: true,
    showUserHeading: true
}), 'top-right');

const statusLine = document.getElementById('status-line');

let connectionsData = {};
let crowdDensityData = {};
let currentStationConnections = null;
let activePopup = null;
let mrtStationsVisible = true;
let busStopDescriptions = {}; // BusStopCode -> Description, used to label search results
let routeGeometryCache = {}; // "ServiceNo|Direction" -> [[lng,lat],...], filled lazily as the user clicks services
let routeMarkers = [];
let routeStopPopup = null;
let activeRouteRequestId = 0; // bumped on every clear/new click so a stale in-flight fetch can't draw over a newer one
let mrtStationFeatures = []; // point features built in loadData(), kept here so search can reuse them
let busServiceRecords = []; // raw /api/bus-services rows: {ServiceNo, Direction, OriginCode, DestinationCode, ...}

const ROUTE_SOURCE_ID = 'selected-bus-route';
const ROUTE_LINE_LAYER_ID = 'selected-bus-route-line';
const ROUTE_ARROW_LAYER_ID = 'selected-bus-route-arrows';
const ROUTE_STOPS_SOURCE_ID = 'selected-bus-route-stops';
const ROUTE_STOPS_LAYER_ID = 'selected-bus-route-stops-layer';

const routeInfoBanner = document.getElementById('route-info-banner');
const routeInfoText = document.getElementById('route-info-text');
document.getElementById('route-info-close').addEventListener('click', clearSelectedRoute);

// Registered once — these fire whenever a feature on this layer id exists,
// regardless of how many times the layer itself gets removed/re-added by
// clearSelectedRoute()/showBusRoute() below.
map.on('mouseenter', ROUTE_STOPS_LAYER_ID, () => { map.getCanvas().style.cursor = 'pointer'; });
map.on('mouseleave', ROUTE_STOPS_LAYER_ID, () => { map.getCanvas().style.cursor = ''; });
map.on('click', ROUTE_STOPS_LAYER_ID, (e) => {
    const feature = e.features[0];
    const { busStopCode, description } = feature.properties;
    if (routeStopPopup) routeStopPopup.remove();
    routeStopPopup = new mapboxgl.Popup({ offset: 8 })
        .setLngLat(feature.geometry.coordinates)
        .setHTML(`<strong>${description}</strong><br>${busStopCode}`)
        .addTo(map);
});

function stationHasConnections(stationEntry) {
    return Boolean(stationEntry && (stationEntry.boardingPoints || []).some(bp => bp.destinations.length > 0));
}

function clearSelectedRoute() {
    activeRouteRequestId++;
    routeMarkers.forEach(m => m.remove());
    routeMarkers = [];
    if (routeStopPopup) { routeStopPopup.remove(); routeStopPopup = null; }
    if (map.getLayer(ROUTE_ARROW_LAYER_ID)) map.removeLayer(ROUTE_ARROW_LAYER_ID);
    if (map.getLayer(ROUTE_LINE_LAYER_ID)) map.removeLayer(ROUTE_LINE_LAYER_ID);
    if (map.getLayer(ROUTE_STOPS_LAYER_ID)) map.removeLayer(ROUTE_STOPS_LAYER_ID);
    if (map.getSource(ROUTE_SOURCE_ID)) map.removeSource(ROUTE_SOURCE_ID);
    if (map.getSource(ROUTE_STOPS_SOURCE_ID)) map.removeSource(ROUTE_STOPS_SOURCE_ID);
    routeInfoBanner.hidden = true;
}

function addRouteMarker(coordinates, label, background) {
    const el = document.createElement('div');
    el.className = 'route-endpoint-marker';
    el.style.background = background;
    el.textContent = label;
    const marker = new mapboxgl.Marker({ element: el, anchor: 'center' }).setLngLat(coordinates).addTo(map);
    routeMarkers.push(marker);
}

// Fetches (or reuses a cached) road-aligned geometry for one bus service/direction
// and draws it on the map. The geometry itself is computed on the server only the
// first time it's requested — snapping each stop to the road network via the
// Mapbox Map Matching API, then routing between the snapped points via the Mapbox
// Directions API (see /api/route-geometry in index.js) — rather than being
// pre-generated for every service up front.
async function showBusRoute(serviceNo, direction) {
    clearSelectedRoute();
    const requestId = activeRouteRequestId;

    routeInfoText.textContent = `Computing route for Bus Service ${serviceNo}…`;
    routeInfoBanner.hidden = false;

    const cacheKey = `${serviceNo}|${direction}`;
    let geometry = routeGeometryCache[cacheKey];

    if (!geometry) {
        try {
            const response = await fetch(`/api/route-geometry?serviceNo=${encodeURIComponent(serviceNo)}&direction=${encodeURIComponent(direction)}`);
            const data = await response.json();
            if (data.error) throw new Error(data.error);
            geometry = data.value;
            routeGeometryCache[cacheKey] = geometry;
        } catch (error) {
            if (requestId !== activeRouteRequestId) return; // superseded by a newer click/clear
            routeInfoText.textContent = `Could not compute route for Bus Service ${serviceNo}: ${error.message}`;
            return;
        }
    }

    if (requestId !== activeRouteRequestId) return; // superseded by a newer click/clear

    const coordinates = geometry ? geometry.coordinates : null;
    if (!coordinates || coordinates.length < 2) {
        routeInfoText.textContent = `No route geometry available for Bus Service ${serviceNo}.`;
        return;
    }

    map.addSource(ROUTE_SOURCE_ID, {
        type: 'geojson',
        data: { type: 'Feature', geometry: { type: 'LineString', coordinates } }
    });

    map.addLayer({
        id: ROUTE_LINE_LAYER_ID,
        type: 'line',
        source: ROUTE_SOURCE_ID,
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#f59e0b', 'line-width': 4, 'line-opacity': 0.9 }
    });

    map.addLayer({
        id: ROUTE_ARROW_LAYER_ID,
        type: 'symbol',
        source: ROUTE_SOURCE_ID,
        layout: {
            'symbol-placement': 'line',
            'symbol-spacing': 80,
            'text-field': '▶',
            'text-size': 12,
            'text-keep-upright': false,
            'text-rotation-alignment': 'map',
            'text-allow-overlap': true,
            'text-ignore-placement': true
        },
        paint: { 'text-color': '#f59e0b', 'text-halo-color': '#ffffff', 'text-halo-width': 1 }
    });

    // Only the stops this specific service/direction actually calls at —
    // not every bus stop in Singapore.
    if (Array.isArray(geometry.stops) && geometry.stops.length > 0) {
        map.addSource(ROUTE_STOPS_SOURCE_ID, {
            type: 'geojson',
            data: {
                type: 'FeatureCollection',
                features: geometry.stops.map(stop => ({
                    type: 'Feature',
                    geometry: { type: 'Point', coordinates: stop.coordinates },
                    properties: { busStopCode: stop.code, description: stop.description }
                }))
            }
        });
        map.addLayer({
            id: ROUTE_STOPS_LAYER_ID,
            type: 'circle',
            source: ROUTE_STOPS_SOURCE_ID,
            paint: {
                'circle-radius': ['interpolate', ['linear'], ['zoom'], 11, 2, 18, 6],
                'circle-color': '#e63946',
                'circle-stroke-width': 1,
                'circle-stroke-color': '#fff'
            }
        });
    }

    addRouteMarker(coordinates[0], 'S', '#16a34a');
    addRouteMarker(coordinates[coordinates.length - 1], 'E', '#dc2626');

    const lngs = coordinates.map(c => c[0]);
    const lats = coordinates.map(c => c[1]);
    map.fitBounds([[Math.min(...lngs), Math.min(...lats)], [Math.max(...lngs), Math.max(...lats)]], { padding: 60 });

    routeInfoText.textContent = `Bus Service ${serviceNo}`
        + (geometry.startName && geometry.endName ? `, ${geometry.startName} → ${geometry.endName}` : '');
    routeInfoBanner.hidden = false;
}

function normalizeStationName(name) {
    return String(name || '')
        .toUpperCase()
        .replace(/\s+MRT STATION$/, '')
        .replace(/\s+LRT STATION$/, '')
        .replace(/\s+/g, ' ')
        .trim();
}

// LTA's TrainStation dataset gives station outlines (polygons), not points —
// use the centroid of the outer ring as the marker/popup anchor.
function polygonCentroid(coordinates) {
    const ring = coordinates[0];
    let x = 0, y = 0;
    for (const [lng, lat] of ring) { x += lng; y += lat; }
    return [x / ring.length, y / ring.length];
}

function applyMrtStationsVisibility() {
    ['mrt-stations-layer', 'mrt-stations-label'].forEach(id => {
        if (map.getLayer(id)) map.setLayoutProperty(id, 'visibility', mrtStationsVisible ? 'visible' : 'none');
    });
}

document.getElementById('toggle-mrt-stations').addEventListener('change', (e) => {
    mrtStationsVisible = e.target.checked;
    applyMrtStationsVisibility();
});

function generateConnectionsHtml(normName) {
    const data = connectionsData[normName];
    if (!data) return '';
    const boardingPoints = data.boardingPoints || [];
    if (boardingPoints.length === 0) {
        return '<p class="empty-note">No free boarding/alighting points on record for this station.</p>';
    }

    let html = '';
    for (const boardingPoint of boardingPoints) {
        const destinations = boardingPoint.destinations;
        const destRowsHtml = destinations.length > 0
            ? destinations.map(dest => {
                const services = dest.services.map(s =>
                    `<span class="service-chip" data-service-no="${s.serviceNo}" data-direction="${s.direction}" ` +
                    `title="Click to show this route on the map">` +
                    `${s.serviceNo}<span class="service-chip-stops">(${s.numStops} stop${s.numStops === 1 ? '' : 's'})</span></span>`
                ).join('');
                return `
                    <div class="connection-row">
                        <div class="connection-dest">
                            <strong>${dest.displayName}</strong>
                            ${dest.lines.map(l => `<span class="line-badge small">${l}</span>`).join('')}
                        </div>
                        <div class="connection-services">${services}</div>
                    </div>
                `;
            }).join('')
            : '<p class="empty-note">No known connections from this stop.</p>';

        const boardingPointName = boardingPoint.name
            ? `<span class="boarding-point-name">${boardingPoint.name}</span>`
            : '';
        html += `
            <div class="boarding-point-group">
                <div class="boarding-point-header">Boarding point <span class="boarding-point-code">${boardingPoint.code}</span>${boardingPointName}</div>
                ${destRowsHtml}
            </div>
        `;
    }
    return html;
}

// Global listener for service-chip clicks inside the map popup
document.getElementById('map').addEventListener('click', (e) => {
    const chip = e.target.closest('.service-chip');
    if (!chip) return;
    const { serviceNo, direction } = chip.dataset;
    showBusRoute(serviceNo, Number(direction));
});

// Shared by clicking a dot on the map and by picking a station from search results.
function selectMrtStation(feature) {
    const { name, normName } = feature.properties;
    
    map.flyTo({ center: feature.geometry.coordinates, zoom: Math.max(map.getZoom(), 14) });

    let crowdHtml = '';
    if (crowdDensityData[normName]) {
        const levels = { 'l': 'Low', 'm': 'Moderate', 'h': 'High' };
        const colors = { 'l': '#16a34a', 'm': '#f59e0b', 'h': '#dc2626' };
        const lvl = crowdDensityData[normName];
        if (levels[lvl]) {
            crowdHtml = `<div style="margin-top: 4px; font-size: 11px; color: ${colors[lvl]}; font-weight: 600;">Crowd Density: ${levels[lvl]}</div>`;
        }
    }

    const connectionsHtml = generateConnectionsHtml(normName);
    const contentHtml = `
        <div style="max-height: 250px; overflow-y: auto; overflow-x: hidden; padding-right: 4px;">
            <div style="font-size: 14px; margin-bottom: 4px;"><strong>${name}</strong></div>
            ${crowdHtml}
            <div style="margin-top: 10px;">${connectionsHtml}</div>
        </div>
    `;

    if (activePopup) activePopup.remove();
    activePopup = new mapboxgl.Popup({ offset: 12, maxWidth: '300px' })
        .setLngLat(feature.geometry.coordinates)
        .setHTML(contentHtml)
        .addTo(map);
}

function getBusStopDescription(busStopCode) {
    return (busStopCode && busStopDescriptions[busStopCode]) || null;
}

// --- Global search: bus service number or MRT station name -----------------
const searchInput = document.getElementById('global-search-input');
const searchSuggestions = document.getElementById('search-suggestions');

function closeSearchSuggestions() {
    searchSuggestions.hidden = true;
    searchSuggestions.innerHTML = '';
}

function getSearchSuggestions(query) {
    const needle = query.trim().toLowerCase();
    if (!needle) return [];

    const stationMatches = mrtStationFeatures
        .filter(f => f.properties.name.toLowerCase().includes(needle))
        .slice(0, 4)
        .map(f => ({ type: 'station', feature: f }));

    // One row per direction, so a service with 2 directions yields 2 selectable results.
    const serviceMatches = busServiceRecords
        .filter(r => r.ServiceNo.toLowerCase().includes(needle))
        .slice(0, 6)
        .map(r => ({
            type: 'bus',
            serviceNo: r.ServiceNo,
            direction: r.Direction,
            originName: getBusStopDescription(r.OriginCode) || r.OriginCode,
            destName: getBusStopDescription(r.DestinationCode) || r.DestinationCode
        }));

    // Kept small enough that a typical (specific) search never needs to scroll —
    // only very broad queries (e.g. a single digit) will fill the dropdown's
    // own scrollable area.
    return [...stationMatches, ...serviceMatches].slice(0, 6);
}

function renderSearchSuggestions(query) {
    const suggestions = getSearchSuggestions(query);
    if (suggestions.length === 0) {
        closeSearchSuggestions();
        return;
    }

    searchSuggestions.innerHTML = suggestions.map(s => {
        if (s.type === 'station') {
            return `<div class="suggestion-item" data-type="station" data-norm-name="${s.feature.properties.normName}">` +
                `<span class="suggestion-badge suggestion-badge-mrt">MRT</span>` +
                `<span class="suggestion-label">${s.feature.properties.name}</span>` +
                `</div>`;
        }
        return `<div class="suggestion-item" data-type="bus" data-service-no="${s.serviceNo}" data-direction="${s.direction}">` +
            `<span class="suggestion-badge suggestion-badge-bus">BUS</span>` +
            `<span class="suggestion-label">${s.serviceNo}<span class="suggestion-sub">${s.originName} → ${s.destName}</span></span>` +
            `</div>`;
    }).join('');
    searchSuggestions.hidden = false;
}

function selectSearchSuggestion(item) {
    if (item.dataset.type === 'station') {
        const feature = mrtStationFeatures.find(f => f.properties.normName === item.dataset.normName);
        if (feature) selectMrtStation(feature);
    } else if (item.dataset.type === 'bus') {
        showBusRoute(item.dataset.serviceNo, Number(item.dataset.direction));
    }
    searchInput.value = '';
    closeSearchSuggestions();
}

searchInput.addEventListener('input', () => renderSearchSuggestions(searchInput.value));

searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        searchInput.blur();
        closeSearchSuggestions();
    } else if (e.key === 'Enter') {
        const firstItem = searchSuggestions.querySelector('.suggestion-item');
        if (firstItem) selectSearchSuggestion(firstItem);
    }
});

// Suggestions are dismissed on blur, but a plain click (not mousedown) on a
// suggestion would fire after that blur has already hidden the list — so
// selection happens on mousedown, with the default prevented to keep focus.
searchSuggestions.addEventListener('mousedown', (e) => {
    e.preventDefault();
    const item = e.target.closest('.suggestion-item');
    if (item) selectSearchSuggestion(item);
});

searchInput.addEventListener('blur', () => {
    setTimeout(closeSearchSuggestions, 150);
});

// --- Panel Toggle -----------------
const panel = document.getElementById('panel');
const panelToggle = document.getElementById('panel-toggle');
panelToggle.addEventListener('click', () => {
    panel.classList.toggle('collapsed');
    panelToggle.textContent = panel.classList.contains('collapsed') ? '❯' : '❮';
});

// --- Tab Switching ----------------
const tabSearch = document.getElementById('tab-search');
const tabP2p = document.getElementById('tab-p2p');
const tabContentSearch = document.getElementById('tab-content-search');
const tabContentP2p = document.getElementById('tab-content-p2p');

tabSearch.addEventListener('click', () => {
    tabSearch.classList.add('active');
    tabP2p.classList.remove('active');
    tabContentSearch.hidden = false;
    tabContentP2p.hidden = true;
});

tabP2p.addEventListener('click', () => {
    tabP2p.classList.add('active');
    tabSearch.classList.remove('active');
    tabContentP2p.hidden = false;
    tabContentSearch.hidden = true;
});

// --- Point-to-Point Search -----------------
const p2pOriginInput = document.getElementById('p2p-origin-input');
const p2pDestInput = document.getElementById('p2p-dest-input');
const p2pOriginSuggestions = document.getElementById('p2p-origin-suggestions');
const p2pDestSuggestions = document.getElementById('p2p-dest-suggestions');
const p2pSearchBtn = document.getElementById('p2p-search-btn');
const p2pClearBtn = document.getElementById('p2p-clear-btn');
const p2pResults = document.getElementById('p2p-results');
let p2pOriginNormName = null;
let p2pDestNormName = null;

function renderP2pSuggestions(input, suggestionsBox, onSelect) {
    const needle = input.value.trim().toLowerCase();
    if (!needle) {
        suggestionsBox.hidden = true;
        return;
    }
    const matches = mrtStationFeatures
        .filter(f => f.properties.name.toLowerCase().includes(needle))
        .slice(0, 5);
    
    if (matches.length === 0) {
        suggestionsBox.hidden = true;
        return;
    }
    
    suggestionsBox.innerHTML = matches.map(f => `
        <div class="suggestion-item p2p-suggestion-item" data-norm-name="${f.properties.normName}" data-name="${f.properties.name}">
            <span class="suggestion-badge suggestion-badge-mrt">MRT</span>
            <span class="suggestion-label">${f.properties.name}</span>
        </div>
    `).join('');
    suggestionsBox.hidden = false;
    
    suggestionsBox.querySelectorAll('.p2p-suggestion-item').forEach(item => {
        item.addEventListener('mousedown', (e) => {
            e.preventDefault();
            input.value = item.dataset.name;
            suggestionsBox.hidden = true;
            onSelect(item.dataset.normName);
        });
    });
}

p2pOriginInput.addEventListener('input', () => renderP2pSuggestions(p2pOriginInput, p2pOriginSuggestions, (normName) => { p2pOriginNormName = normName; }));
p2pDestInput.addEventListener('input', () => renderP2pSuggestions(p2pDestInput, p2pDestSuggestions, (normName) => { p2pDestNormName = normName; }));

p2pOriginInput.addEventListener('blur', () => setTimeout(() => p2pOriginSuggestions.hidden = true, 150));
p2pDestInput.addEventListener('blur', () => setTimeout(() => p2pDestSuggestions.hidden = true, 150));

p2pClearBtn.addEventListener('click', () => {
    p2pOriginInput.value = '';
    p2pDestInput.value = '';
    p2pOriginNormName = null;
    p2pDestNormName = null;
    p2pResults.innerHTML = '';
});

p2pSearchBtn.addEventListener('click', () => {
    let origFeat = mrtStationFeatures.find(f => f.properties.normName === p2pOriginNormName || f.properties.name.toLowerCase() === p2pOriginInput.value.trim().toLowerCase());
    let destFeat = mrtStationFeatures.find(f => f.properties.normName === p2pDestNormName || f.properties.name.toLowerCase() === p2pDestInput.value.trim().toLowerCase());
    
    if (origFeat) p2pOriginNormName = origFeat.properties.normName;
    if (destFeat) p2pDestNormName = destFeat.properties.normName;

    if (!p2pOriginNormName || !p2pDestNormName) {
        p2pResults.innerHTML = '<p class="empty-note">Please select both origin and destination from the suggestions.</p>';
        return;
    }
    
    const connections = connectionsData[p2pOriginNormName];
    if (!connections || !connections.boardingPoints) {
        p2pResults.innerHTML = '<p class="empty-note">No bus connections found for the origin station.</p>';
        return;
    }
    
    let anyMatches = false;
    p2pResults.innerHTML = '';
    const targetDisplayName = connectionsData[p2pDestNormName] ? connectionsData[p2pDestNormName].displayName : destFeat.properties.name;
    
    for (const boardingPoint of connections.boardingPoints) {
        const dest = boardingPoint.destinations.find(d => d.displayName === targetDisplayName || d.displayName.toUpperCase() === p2pDestNormName);
        if (dest && dest.services.length > 0) {
            anyMatches = true;
            const services = dest.services.map(s => 
                `<span class="service-chip" data-service-no="${s.serviceNo}" data-direction="${s.direction}" title="Click to show this route on the map">` +
                `${s.serviceNo}<span class="service-chip-stops">(${s.numStops} stop${s.numStops === 1 ? '' : 's'})</span></span>`
            ).join('');
            
            const boardingPointName = boardingPoint.name ? `<span class="boarding-point-name">${boardingPoint.name}</span>` : '';
            const html = `
                <div class="boarding-point-group" style="margin-bottom: 12px;">
                    <div class="boarding-point-header">Boarding point <span class="boarding-point-code">${boardingPoint.code}</span>${boardingPointName}</div>
                    <div class="connection-row">
                        <div class="connection-services">${services}</div>
                    </div>
                </div>
            `;
            p2pResults.innerHTML += html;
        }
    }
    
    if (!anyMatches) {
        p2pResults.innerHTML = '<p class="empty-note">No direct bridging bus services between these two stations.</p>';
    }
});

p2pResults.addEventListener('click', (e) => {
    const chip = e.target.closest('.service-chip');
    if (!chip) return;
    const { serviceNo, direction } = chip.dataset;
    showBusRoute(serviceNo, Number(direction));
});

async function loadData() {
    const [stationsRes, connectionsRes, busStopsRes, busServicesRes, crowdDensityRes] = await Promise.all([
        fetch('/api/mrt-stations').then(r => r.json()),
        fetch('/api/mrt-connections').then(r => r.json()),
        fetch('/api/bus-stops').then(r => r.json()).catch(err => ({ error: err.message })),
        fetch('/api/bus-services').then(r => r.json()).catch(err => ({ error: err.message })),
        fetch('/api/mrt-crowd-density').then(r => r.json()).catch(err => ({ error: err.message }))
    ]);

    if (stationsRes.error) throw new Error(stationsRes.error);
    if (connectionsRes.error) throw new Error(connectionsRes.error);

    if (busServicesRes && !busServicesRes.error && Array.isArray(busServicesRes.value)) {
        busServiceRecords = busServicesRes.value;
    } else if (busServicesRes && busServicesRes.error) {
        console.error('Failed to load bus services:', busServicesRes.error);
    }

    if (busStopsRes && !busStopsRes.error && Array.isArray(busStopsRes.value)) {
        busStopDescriptions = {};
        for (const stop of busStopsRes.value) {
            busStopDescriptions[stop.BusStopCode] = stop.Description;
        }
    } else if (busStopsRes && busStopsRes.error) {
        console.error('Failed to load bus stops:', busStopsRes.error);
    }
    
    if (crowdDensityRes && !crowdDensityRes.error && crowdDensityRes.value) {
        crowdDensityData = crowdDensityRes.value;
    } else if (crowdDensityRes && crowdDensityRes.error) {
        console.error('Failed to load crowd density:', crowdDensityRes.error);
    }

    connectionsData = connectionsRes.value || {};
    const geojson = stationsRes.value;
    if (!geojson || !geojson.features || geojson.features.length === 0) {
        statusLine.textContent = 'No MRT station data. Run "npm run fetch-mrt-stations" then reload.';
        return;
    }

    const pointFeatures = geojson.features.map(f => {
        const normName = normalizeStationName(f.properties.STN_NAM_DE);
        const hasConnections = stationHasConnections(connectionsData[normName]);
        const crowdDensity = crowdDensityData[normName] || 'none';
        return {
            type: 'Feature',
            geometry: { type: 'Point', coordinates: polygonCentroid(f.geometry.coordinates) },
            properties: {
                name: f.properties.STN_NAM_DE,
                normName,
                hasConnections,
                crowdDensity
            }
        };
    });

    mrtStationFeatures = pointFeatures;
    map.addSource('mrt-stations', { type: 'geojson', data: { type: 'FeatureCollection', features: pointFeatures } });

    map.addLayer({
        id: 'mrt-stations-layer',
        type: 'circle',
        source: 'mrt-stations',
        paint: {
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 10, 3, 16, 9],
            'circle-color': [
                'match',
                ['get', 'crowdDensity'],
                'l', '#16a34a',
                'm', '#f59e0b',
                'h', '#dc2626',
                ['case', ['get', 'hasConnections'], '#1d4ed8', '#9ca3af']
            ],
            'circle-stroke-color': '#ffffff',
            'circle-stroke-width': 1.5
        }
    });

    map.addLayer({
        id: 'mrt-stations-label',
        type: 'symbol',
        source: 'mrt-stations',
        minzoom: 13,
        layout: {
            'text-field': ['get', 'name'],
            'text-size': 11,
            'text-offset': [0, 1.2],
            'text-anchor': 'top'
        },
        paint: {
            'text-color': '#111827',
            'text-halo-color': '#ffffff',
            'text-halo-width': 1.2
        }
    });

    map.on('mouseenter', 'mrt-stations-layer', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'mrt-stations-layer', () => { map.getCanvas().style.cursor = ''; });

    map.on('click', 'mrt-stations-layer', (e) => selectMrtStation(e.features[0]));

    applyMrtStationsVisibility();

    const matched = pointFeatures.filter(f => f.properties.hasConnections).length;
    statusLine.textContent = `${pointFeatures.length} MRT stations loaded (${matched} with known bus connections). Click a station to explore.`;
}

map.on('load', () => {
    loadData().catch(err => {
        statusLine.textContent = 'Failed to load data: ' + err.message;
        console.error(err);
    });
});
</script>
</body>
</html>
