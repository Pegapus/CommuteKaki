<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Commuter Companion</title>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div id="map"></div>

<div id="panel">
    <div id="panel-header">
        <h1>Smart Commuter Companion</h1>
        <p id="panel-subtitle">Click an MRT station to see bus services connecting it to another station via free boarding/alighting points.</p>
    </div>
    <div id="status-line">Loading MRT stations…</div>
    <div id="station-detail" hidden>
        <button id="close-detail" title="Close">&times;</button>
        <h2 id="detail-station-name"></h2>
        <div id="detail-station-lines"></div>
        <input id="detail-filter" type="text" placeholder="Filter destination stations…" />
        <div id="detail-connections"></div>
    </div>
</div>

<script>
const MAPBOX_API_KEY = <%- JSON.stringify(MAPBOX_API_KEY) %>;
mapboxgl.accessToken = MAPBOX_API_KEY;

const map = new mapboxgl.Map({
    container: 'map',
    style: 'mapbox://styles/mapbox/light-v11',
    center: [103.8198, 1.3521],
    zoom: 11,
    maxBounds: [[103.55, 1.15], [104.15, 1.5]]
});

const statusLine = document.getElementById('status-line');
const detailPanel = document.getElementById('station-detail');
const detailName = document.getElementById('detail-station-name');
const detailLines = document.getElementById('detail-station-lines');
const detailConnections = document.getElementById('detail-connections');
const detailFilter = document.getElementById('detail-filter');
document.getElementById('close-detail').addEventListener('click', () => {
    detailPanel.hidden = true;
    statusLine.hidden = false;
});

let connectionsData = {};
let currentStationConnections = null;
let activePopup = null;

function normalizeStationName(name) {
    return String(name || '')
        .toUpperCase()
        .replace(/\s+MRT STATION$/, '')
        .replace(/\s+LRT STATION$/, '')
        .replace(/\s+/g, ' ')
        .trim();
}

// LTA's TrainStation dataset gives station outlines (polygons), not points —
// use the centroid of the outer ring as the marker/popup anchor.
function polygonCentroid(coordinates) {
    const ring = coordinates[0];
    let x = 0, y = 0;
    for (const [lng, lat] of ring) { x += lng; y += lat; }
    return [x / ring.length, y / ring.length];
}

function renderConnections(normName, displayName, lines) {
    currentStationConnections = connectionsData[normName] || null;
    detailName.textContent = displayName;
    detailLines.innerHTML = (lines || []).map(l => `<span class="line-badge">${l}</span>`).join('');
    detailFilter.value = '';
    drawConnectionsList('');
    detailPanel.hidden = false;
    statusLine.hidden = true;
}

function drawConnectionsList(filterText) {
    detailConnections.innerHTML = '';
    if (!currentStationConnections) {
        detailConnections.innerHTML = '<p class="empty-note">No free boarding/alighting points on record for this station.</p>';
        return;
    }
    const entries = Object.values(currentStationConnections.connections || {})
        .sort((a, b) => a.displayName.localeCompare(b.displayName));

    const filtered = filterText
        ? entries.filter(e => e.displayName.toLowerCase().includes(filterText.toLowerCase()))
        : entries;

    if (filtered.length === 0) {
        detailConnections.innerHTML = '<p class="empty-note">No matching destination stations.</p>';
        return;
    }

    for (const dest of filtered) {
        const row = document.createElement('div');
        row.className = 'connection-row';
        const services = dest.services.map(s => `<span class="service-chip" title="Board ${s.boardStopCode} → Alight ${s.alightStopCode}">${s.serviceNo}</span>`).join('');
        row.innerHTML = `
            <div class="connection-dest">
                <strong>${dest.displayName}</strong>
                ${dest.lines.map(l => `<span class="line-badge small">${l}</span>`).join('')}
            </div>
            <div class="connection-services">${services}</div>
        `;
        detailConnections.appendChild(row);
    }
}

detailFilter.addEventListener('input', () => drawConnectionsList(detailFilter.value.trim()));

async function loadData() {
    const [stationsRes, connectionsRes] = await Promise.all([
        fetch('/api/mrt-stations').then(r => r.json()),
        fetch('/api/mrt-connections').then(r => r.json())
    ]);

    if (stationsRes.error) throw new Error(stationsRes.error);
    if (connectionsRes.error) throw new Error(connectionsRes.error);

    connectionsData = connectionsRes.value || {};
    const geojson = stationsRes.value;
    if (!geojson || !geojson.features || geojson.features.length === 0) {
        statusLine.textContent = 'No MRT station data. Run "npm run fetch-mrt-stations" then reload.';
        return;
    }

    const pointFeatures = geojson.features.map(f => {
        const normName = normalizeStationName(f.properties.STN_NAM_DE);
        const hasConnections = Boolean(connectionsData[normName] && Object.keys(connectionsData[normName].connections || {}).length > 0);
        return {
            type: 'Feature',
            geometry: { type: 'Point', coordinates: polygonCentroid(f.geometry.coordinates) },
            properties: {
                name: f.properties.STN_NAM_DE,
                normName,
                hasConnections
            }
        };
    });

    map.addSource('mrt-stations', { type: 'geojson', data: { type: 'FeatureCollection', features: pointFeatures } });

    map.addLayer({
        id: 'mrt-stations-layer',
        type: 'circle',
        source: 'mrt-stations',
        paint: {
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 10, 3, 16, 9],
            'circle-color': ['case', ['get', 'hasConnections'], '#1d4ed8', '#9ca3af'],
            'circle-stroke-color': '#ffffff',
            'circle-stroke-width': 1.5
        }
    });

    map.addLayer({
        id: 'mrt-stations-label',
        type: 'symbol',
        source: 'mrt-stations',
        minzoom: 13,
        layout: {
            'text-field': ['get', 'name'],
            'text-size': 11,
            'text-offset': [0, 1.2],
            'text-anchor': 'top'
        },
        paint: {
            'text-color': '#111827',
            'text-halo-color': '#ffffff',
            'text-halo-width': 1.2
        }
    });

    map.on('mouseenter', 'mrt-stations-layer', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'mrt-stations-layer', () => { map.getCanvas().style.cursor = ''; });

    map.on('click', 'mrt-stations-layer', (e) => {
        const feature = e.features[0];
        const { name, normName } = feature.properties;
        renderConnections(normName, connectionsData[normName] ? connectionsData[normName].displayName : name, connectionsData[normName] ? connectionsData[normName].lines : []);

        if (activePopup) activePopup.remove();
        activePopup = new mapboxgl.Popup({ offset: 12 })
            .setLngLat(feature.geometry.coordinates)
            .setHTML(`<strong>${name}</strong>`)
            .addTo(map);
    });

    const matched = pointFeatures.filter(f => f.properties.hasConnections).length;
    statusLine.textContent = `${pointFeatures.length} MRT stations loaded (${matched} with known bus connections). Click a station to explore.`;
}

map.on('load', () => {
    loadData().catch(err => {
        statusLine.textContent = 'Failed to load data: ' + err.message;
        console.error(err);
    });
});
</script>
</body>
</html>
