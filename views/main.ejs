async function searchPlaces(text, signal) {
    const res = await fetch('/api/places?q=' + encodeURIComponent(text), { signal });
    if (!res.ok) throw new Error('Place search is unavailable. Try again or tap the map.');
    const data = await res.json();
    return data.places || [];
}
async function geocodePlace(text) { return (await searchPlaces(text))[0] || null; }
function setupPlaceSuggestions(input, container, choose) {
    let timer, controller, version = 0, places = [], active = -1;
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-autocomplete', 'list');
    input.setAttribute('aria-controls', container.id);
    input.setAttribute('aria-expanded', 'false');
    container.setAttribute('role', 'listbox');
    function close() { container.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); }
    function select(index) {
        if (!places[index]) return;
        version++; clearTimeout(timer); controller?.abort();
        choose(places[index]); input.value = places[index].name; close(); input.blur(); updateOtpMarkers();
    }
    input.addEventListener('input', () => {
        clearTimeout(timer); controller?.abort(); const request = ++version; close();
        const query = input.value.trim(); if (query.length < 2) return;
        timer = setTimeout(async () => {
            controller = new AbortController();
            try {
                const results = await searchPlaces(query, controller.signal);
                if (request !== version) return;
                places = results; active = -1;
                container.innerHTML = places.length ? places.map((place, index) => '<button type="button" role="option" aria-selected="false" id="' + container.id + '-' + index + '" data-place="' + index + '" class="place-option">' + escapeHtml(place.name) + '</button>').join('') : '<div class="place-message">No places found. Try an address or postcode.</div>';
                container.hidden = false; input.setAttribute('aria-expanded', 'true');
            } catch (error) {
                if (error.name === 'AbortError' || request !== version) return;
                places = [];
                container.innerHTML = '<div class="place-message">Place search unavailable. Try again or tap the map.</div>';
                container.hidden = false; input.setAttribute('aria-expanded', 'true');
            }
        }, 300);
    });
    container.addEventListener('pointerdown', event => event.preventDefault());
    container.addEventListener('click', event => { const option = event.target.closest('[data-place]'); if (option) select(Number(option.dataset.place)); });
    input.addEventListener('keydown', event => {
        if (event.key === 'Escape') { version++; controller?.abort(); close(); }
        if (container.hidden || !places.length) return;
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault(); active = (active + (event.key === 'ArrowDown' ? 1 : -1) + places.length) % places.length;
            container.querySelectorAll('[data-place]').forEach((option, index) => option.setAttribute('aria-selected', String(index === active)));
            input.setAttribute('aria-activedescendant', container.id + '-' + active);
            container.children[active]?.scrollIntoView({ block: 'nearest' });
        }
        if (event.key === 'Enter' && active >= 0) { event.preventDefault(); select(active); }
    });
    input.addEventListener('blur', () => { version++; clearTimeout(timer); controller?.abort(); close(); });
}
setupPlaceSuggestions(otpOriginInput, document.getElementById('otp-origin-suggestions'), place => { otpOrigin = place; });
setupPlaceSuggestions(otpDestInput, document.getElementById('otp-dest-suggestions'), place => { otpDest = place; });

function decodePolyline(str, precision) {
    let index = 0, lat = 0, lng = 0, coordinates = [], shift = 0, result = 0, byte = null;
    let latitude_change, longitude_change, factor = Math.pow(10, precision !== undefined ? precision : 5);
    while (index < str.length) {
        byte = null; shift = 0; result = 0;
        do { byte = str.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20);
        latitude_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
        shift = result = 0;
        do { byte = str.charCodeAt(index++) - 63; result |= (byte & 0x1f) << shift; shift += 5; } while (byte >= 0x20);
        longitude_change = ((result & 1) ? ~(result >> 1) : (result >> 1));
        lat += latitude_change; lng += longitude_change;
        coordinates.push([lng / factor, lat / factor]);
    }
    return coordinates;
}

const dateField = document.getElementById('otp-date-input');
