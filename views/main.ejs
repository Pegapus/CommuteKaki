const otpMaxCrowd = document.getElementById('otp-max-crowd');
const otpMaxTransfers = document.getElementById('otp-max-transfers');
const otpMaxWalk = document.getElementById('otp-max-walk');
const otpIncludeUnknown = document.getElementById('otp-include-unknown');
let otpItineraries = [];
let selectedOtpRoute = 0;
const otpSort = document.getElementById('otp-sort');
function rankOtpRoutes() {
    const number = value => Number.isFinite(Number(value)) ? Number(value) : Infinity;
    const crowdScore = route => route.crowd?.complete ? ({ l: 0, m: 1, h: 2 }[route.crowd.level] ?? 4) : route.crowd?.level && route.crowd.level !== 'unknown' ? 3 : 4;
    const score = route => otpPreference.value === 'crowd' ? crowdScore(route) : number(route[otpPreference.value === 'transfers' ? 'transfers' : otpPreference.value === 'walking' ? 'walkDistance' : 'duration']);
    otpItineraries.sort((a, b) => score(a) - score(b) || number(a.duration) - number(b.duration) || number(a.walkDistance) - number(b.walkDistance));
    selectedOtpRoute = 0; renderOtpRoutes();
    if (otpItineraries.length) drawOtpItinerary(otpItineraries[0]);
}
otpPreference.addEventListener('change', rankOtpRoutes);

function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, character => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[character]);
}

function otpCrowdLabel(crowd) {
    if (!crowd || crowd.level === 'unknown') return 'Crowd unknown';
    const names = { l: 'Low crowd', m: 'Moderate crowd', h: 'High crowd' };
    return (names[crowd.level] || 'Crowd unknown') + (crowd.complete ? '' : ' · partial');
}

function legDisplayName(leg) {
    const mode = String(leg.mode || '').toUpperCase();
    if (mode === 'WALK') return 'Walk';
    if (mode === 'BUS') return `Bus ${leg.route || leg.routeShortName || ''}`.trim();
    const lines = { NE: 'NEL', EW: 'EWL', NS: 'NSL', CC: 'CCL', DT: 'DTL', TE: 'TEL', CG: 'CGL', CE: 'CEL' };
    const route = lines[leg.route] || leg.route || leg.routeShortName || '';
    return `Train ${route}`.trim();
}

function itineraryFeatures(itinerary) {
    return (itinerary.legs || []).flatMap(leg => {
        if (!leg.legGeometry?.points) return [];
        const coordinates = decodePolyline(leg.legGeometry.points);
        return coordinates.length >= 2 ? [{
            type: 'Feature', properties: { mode: String(leg.mode || '').toUpperCase() },
            geometry: { type: 'LineString', coordinates }
        }] : [];
    });
}

function drawOtpItinerary(itinerary) {
    clearSelectedRoute();
    updateOtpMarkers();
    const features = itineraryFeatures(itinerary);
    if (!features.length) return;
    map.addSource(ROUTE_SOURCE_ID, {
        type: 'geojson', data: { type: 'FeatureCollection', features }
    });
    map.addLayer({
        id: ROUTE_WALK_OUTLINE_LAYER_ID, type: 'line', source: ROUTE_SOURCE_ID,
        filter: ['==', ['get', 'mode'], 'WALK'],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#ffffff', 'line-width': 8, 'line-opacity': .9 }
    }, 'waterway-label');
    map.addLayer({
        id: ROUTE_LINE_LAYER_ID, type: 'line', source: ROUTE_SOURCE_ID,
        filter: ['!=', ['get', 'mode'], 'WALK'],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
            'line-color': ['match', ['get', 'mode'], 'BUS', '#22c55e', '#ef4444'],
            'line-width': 5
        }
    }, 'waterway-label');
    map.addLayer({
        id: ROUTE_WALK_LAYER_ID, type: 'line', source: ROUTE_SOURCE_ID,
        filter: ['==', ['get', 'mode'], 'WALK'],
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#64748b', 'line-width': 5, 'line-dasharray': [.1, 1.8] }
    }, 'waterway-label');
    const bounds = new mapboxgl.LngLatBounds();
    features.flatMap(feature => feature.geometry.coordinates).forEach(coordinate => bounds.extend(coordinate));
    const mobile = window.innerWidth < 768;
    map.fitBounds(bounds, { padding: mobile
        ? { top: Math.min(panel.getBoundingClientRect().height + 52, window.innerHeight * .65), bottom: 90, left: 24, right: 55 }
        : { top: 60, bottom: 60, left: 450, right: 60 } });
}

function renderOtpRoutes() {
    otpResults.innerHTML = otpItineraries.map((itinerary, index) => {
        const crowd = itinerary.crowd || { level: 'unknown', complete: false, stations: [] };
        const walking = Number.isFinite(Number(itinerary.walkDistance)) ? `${Math.round(itinerary.walkDistance)} m walk` : 'Walk unknown';
        const transfers = Number.isFinite(Number(itinerary.transfers)) ? Number(itinerary.transfers) : 0;
        const legDetails = index === selectedOtpRoute ? `<div class="otp-legs">${(itinerary.legs || []).map(leg => `
            <div class="otp-leg"><strong>${escapeHtml(legDisplayName(leg))}</strong>: ${escapeHtml(leg.from?.name || 'Start')} → ${escapeHtml(leg.to?.name || 'Destination')} · ${Math.round(Number(leg.duration || 0) / 60)} min</div>
        `).join('')}</div>` : '';
        return `<button type="button" class="otp-route-card${index === selectedOtpRoute ? ' selected' : ''}" data-route-index="${index}" aria-pressed="${index === selectedOtpRoute}">
            <div class="otp-card-heading"><strong>${Math.round(Number(itinerary.duration || 0) / 60)} min</strong><span>${index === 0 ? 'Recommended' : 'Alternative ' + index}</span></div>
            <div class="otp-card-metrics"><span>${transfers} transfer${transfers === 1 ? '' : 's'}</span><span>${walking}</span></div>
            <span class="otp-crowd otp-crowd-${crowd.level}">${escapeHtml(otpCrowdLabel(crowd))}</span>
            ${legDetails}
        </button>`;
    }).join('');
}

function selectOtpItinerary(index) {
    if (!otpItineraries[index]) return;
    selectedOtpRoute = index;
    renderOtpRoutes();
    drawOtpItinerary(otpItineraries[index]);
}

otpResults.addEventListener('click', event => {
    const card = event.target.closest('[data-route-index]');
    if (card) selectOtpItinerary(Number(card.dataset.routeIndex));
});

otpClearBtn.addEventListener('click', () => {
    otpOrigin = null; otpDest = null;
    otpOriginInput.value = ''; otpDestInput.value = '';
    otpStatus.textContent = ''; otpResults.innerHTML = '';
    otpItineraries = []; selectedOtpRoute = 0;
    otpSort.hidden = true; departureEdited = false; setCurrentDeparture();
    activeOtpInput = 'origin';
    updateOtpMarkers();
    clearSelectedRoute();
});

otpSearchBtn.addEventListener('click', async () => {
    setCurrentDeparture();
    otpItineraries = []; otpResults.innerHTML = ''; otpSort.hidden = true;
    otpStatus.textContent = 'Finding your travel options?';
    otpSearchBtn.disabled = true;
    otpSearchBtn.textContent = 'Finding routes…';
    clearSelectedRoute();

    try {
        if (!otpOrigin && otpOriginInput.value.trim()) otpOrigin = await geocodePlace(otpOriginInput.value.trim());
        if (!otpDest && otpDestInput.value.trim()) otpDest = await geocodePlace(otpDestInput.value.trim());

        if (!otpOrigin || !otpDest) {
            otpStatus.textContent = 'Please specify valid origin and destination.';
            return;
        }
        
        otpOriginInput.value = otpOrigin.name;
        otpDestInput.value = otpDest.name;
        updateOtpMarkers();
        
        const params = new URLSearchParams({
            fromPlace: `${otpOrigin.lat},${otpOrigin.lon}`,
            toPlace: `${otpDest.lat},${otpDest.lon}`,
            preference: otpPreference.value,
            maxCrowd: otpMaxCrowd.value,
            maxTransfers: otpMaxTransfers.value,
            maxWalk: otpMaxWalk.value,
            includeUnknown: String(otpIncludeUnknown.checked)
        });
        
        const dateInput = document.getElementById('otp-date-input').value;
        const timeInput = document.getElementById('otp-time-input').value;
        
        if (dateInput) {
            params.append('date', dateInput);
        }
        if (timeInput) {
            params.append('time', timeInput);
        }
        
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 90000);
        const res = await fetch(`/api/routing/plan?${params.toString()}`, { signal: controller.signal }).finally(() => clearTimeout(timeout));
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to fetch routes from OneMap.');
        
        if (data.error || !data.plan || !data.plan.itineraries || data.plan.itineraries.length === 0) {
            const found = Number(data.metadata?.candidateCount || 0);
            otpStatus.textContent = found
                ? `${found} routes were found, but none match all filters. Try allowing more walking, transfers, or unknown crowding.`
                : 'No routes found for this departure time.';
            otpResults.innerHTML = '';
            return;
        }

        otpItineraries = data.plan.itineraries;
        selectedOtpRoute = 0;
        const failures = Number(data.metadata?.profileErrors?.length || 0);
        otpStatus.textContent = `${otpItineraries.length} matching route${otpItineraries.length === 1 ? '' : 's'} from ${data.metadata?.candidateCount || otpItineraries.length} distinct options.` +
            (failures ? ' Some OneMap searches were unavailable; retry for more options.' : '');
        otpSort.hidden = false;
        rankOtpRoutes();
    } catch (err) {
        console.error(err);
        otpStatus.textContent = err.name === 'AbortError' ? 'Route search timed out. Please try again.' : 'Error: ' + err.message;
    } finally {
        otpSearchBtn.disabled = false;
        otpSearchBtn.textContent = 'Find Routes';
    }
});

map.on('load', () => {
    loadData().catch(err => {
        statusLine.textContent = 'Failed to load data: ' + err.message;
        console.error(err);
    });
    
    // Initial fetch, and if it yields an alert, we can also auto-show the banner
    fetchTrainAlerts().then(() => {
        if (!alertsToggle.hidden) {
            alertsBanner.hidden = false;
        }
    });
});
</script>
</body>
</html>
